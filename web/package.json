{
  "name": "heatmatch-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "wasm": "wasm-pack build ../core/heatmatch-wasm --target bundler --release --out-dir ../../web/src/wasm",
    "copy-data": "node scripts/copy-data.mjs",
    "predev": "pnpm run wasm && pnpm run copy-data",
    "prebuild": "pnpm run wasm && pnpm run copy-data",
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src"
  },
  "dependencies": {
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.1.0",
    "prettier": "^3",
    "typescript": "^5.7"
  }
}
